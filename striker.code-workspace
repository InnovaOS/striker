{
  "folders": [
    {
      "path": "packages/vscode-extension"
    },
    {
      "path": "packages/cline-adapter"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/out": false
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Striker Extension",
        "type": "extensionHost",
        "request": "launch",
        "runtimeExecutable": "${execPath}",
        "args": [
          "--extensionDevelopmentPath=${workspaceFolder:packages/vscode-extension}"
        ],
        "outFiles": [
          "${workspaceFolder:packages/vscode-extension}/out/**/*.js"
        ],
        "preLaunchTask": "tsc: build - vscode-extension"
      }
    ]
  }
}
