{
  "name": "striker-vscode",
  "main": "./out/extension.js",
  "displayName": "Striker",
  "publisher": "striker",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:striker.runAgent",
    "onCommand:striker.runAgentPrompt",
    "onCommand:striker.showDemo",
    "onCommand:striker.openLogs",
    "onCommand:striker.exportLastRun",
    "onCommand:striker.createIssueDraft",
    "onCommand:striker.exportResults",
    "onCommand:striker.openResultsPanel",
    "onCommand:striker.runCoreAgentGoal",
    "onCommand:striker.openFileAt",
    "onCommand:striker.applyLastRun",
    "onCommand:striker.agent.runGoal"

      ],
  "contributes": {
    "commands": [
      {
        "command": "striker.runAgent",
        "title": "Striker: Run Agent"
      },
      {
        "command": "striker.runAgentPrompt",
        "title": "Striker: Run Agent (Prompt)"
      },
      {
        "command": "striker.showDemo",
        "title": "Striker: Show Demo"
      },
      {
        "command": "striker.openLogs",
        "title": "Striker: Open Logs"
      },
      {
        "command": "striker.exportResults",
        "title": "Striker: Export Last Results (JSON)"
      },
      {
        "command": "striker.exportLastRun",
        "title": "Striker: Export Last Run"
      },
      {
        "command": "striker.createIssueDraft",
        "title": "Striker: Create Issue Draft"
      },
      {
        "command": "striker.openResultsPanel",
        "title": "Striker: Open Results Panel"
      },
      {
        "command": "striker.openFileAt",
        "title": "Striker: Open File At"
      },
      {
        "command": "striker.applyLastRun",
        "title": "Striker: Apply Last Run (Write Files)"
      },
      
      {
        "command": "striker.runCoreAgentGoal",
        "title": "Striker: Run Core Agent Goal",
        "category": "Striker"
      }
    ],
    "keybindings": [
      {
        "command": "striker.runCoreAgentGoal",
        "key": "ctrl+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "striker.openResultsPanel",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "striker.agent.runGoal",
        "title": "Striker: Agent Run (Goal)",
         "category": "Striker"
      }

    ],
    "menus": {
      "commandPalette": [
        {
          "command": "striker.runCoreAgentGoal",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "build": "tsc -p ."
  },
  "dependencies": {
    "@striker/core-agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
