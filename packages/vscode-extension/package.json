{
  "name": "striker-vscode",
  "displayName": "Striker",
  "publisher": "striker",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:striker.runAgent"
  ],
  "contributes": {
    "commands": [
      {
        "command": "striker.runAgent",
        "title": "Striker: Run Agent"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.85.0"
  }
}
