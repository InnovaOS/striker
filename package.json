{
  "name": "striker",
  "private": true,
  "version": "0.1.0",
  "description": "Striker monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "pnpm -r --workspace-concurrency=1 run compile",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "watch": "pnpm -r --workspace-concurrency=1 run watch",
    "clean": "pnpm -r --filter \"./packages/*\" run clean || true"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "anthropic": "^0.0.0"
  }
}
